.shiori-root {
    flex-grow: 1;
}

.shiori-lock-banner {
    flex-direction: row;
    align-items: center;
    padding: 6px 10px;
    margin: 6px;
    border-radius: 4px;
    background-color: rgba(255, 196, 0, 0.18);
    border-width: 1px;
    border-color: rgba(255, 196, 0, 0.6);
}

.shiori-lock-banner--hidden {
    display: none;
}

.shiori-lock-message {
    white-space: normal;
    flex-shrink: 1;
}

.shiori-content {
    flex-grow: 1;
    padding: 6px;
}

.shiori-content--locked {
    opacity: 0.5;
}

.shiori-hidden {
    display: none;
}

.shiori-error {
    white-space: normal;
    color: rgb(214, 78, 78);
    margin: 4px 0;
}

.shiori-primary-button {
    align-self: flex-start;
    min-width: 140px;
    margin: 4px 0;
}

/* --- Setup wizard --- */

.shiori-wizard {
    flex-grow: 1;
}

.shiori-wizard-title {
    font-size: 16px;
    -unity-font-style: bold;
    margin: 4px 4px 2px 4px;
}

.shiori-wizard-intro {
    white-space: normal;
    margin: 0 4px 10px 4px;
    opacity: 0.85;
}

.shiori-wizard-steps {
    flex-direction: column;
}

.shiori-step {
    margin: 0 4px 8px 4px;
    padding: 8px 10px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.35);
    background-color: rgba(128, 128, 128, 0.08);
}

.shiori-step--current {
    border-color: rgba(88, 150, 255, 0.9);
    background-color: rgba(88, 150, 255, 0.08);
}

.shiori-step--done {
    opacity: 0.8;
}

.shiori-step--disabled {
    opacity: 0.5;
}

.shiori-step-header {
    flex-direction: row;
    align-items: center;
}

.shiori-step-number {
    width: 22px;
    height: 22px;
    border-radius: 11px;
    -unity-text-align: middle-center;
    background-color: rgba(128, 128, 128, 0.35);
    margin-right: 8px;
}

.shiori-step--done .shiori-step-number {
    background-color: rgba(76, 175, 80, 0.75);
}

.shiori-step-title {
    font-size: 13px;
    -unity-font-style: bold;
    flex-grow: 1;
}

.shiori-step-state {
    opacity: 0.8;
}

.shiori-step-body {
    margin-top: 6px;
    margin-left: 30px;
}

.shiori-step-message {
    white-space: normal;
}

.shiori-step-detail {
    white-space: normal;
    opacity: 0.75;
    margin-top: 2px;
}

.shiori-step-controls {
    flex-direction: column;
    margin-top: 6px;
}

.shiori-step-controls-row {
    flex-direction: row;
    flex-wrap: wrap;
}

.shiori-step-controls-row > Button {
    margin: 2px 6px 2px 0;
}

.shiori-step-error {
    white-space: normal;
    color: rgb(214, 78, 78);
    margin-top: 4px;
}

.shiori-identity-field {
    margin: 2px 0;
}

.shiori-wizard-finish {
    margin: 4px;
    flex-direction: column;
}

.shiori-wizard-finish-message {
    white-space: normal;
    margin-bottom: 4px;
}
